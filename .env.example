# Google Gemini — required for Adel (voice platform guide)
GEMINI_API_KEY=

# Supabase — REQUIRED. Discovery bookings and reviews are stored here.
# Without these, bookings are not saved. Run supabase/schema.sql once to
# create the tables before going live.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — REQUIRED for Discovery Call emails.
# DISCOVERY_FROM_EMAIL must use a domain verified in Resend, and must be an
# AestheticBiz address: visitors book on AestheticBiz and must hear from
# AestheticBiz, never from another brand.
RESEND_API_KEY=
DISCOVERY_FROM_EMAIL="AestheticBiz <bookings@aestheticbiz.site>"
DISCOVERY_ADMIN_EMAIL=

# Admin dashboard login (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=
